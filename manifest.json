{
  "manifest_version": 3,
  "name": "LeadScout - Free LinkedIn Email Prospector",
  "version": "1.3.0",
  "description": "Free Apollo-style prospector for LinkedIn. Discover verified corporate emails, mobile phone numbers, and export leads.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://autocomplete.clearbit.com/*",
    "https://cloudflare-dns.com/*",
    "https://api.apollo.io/*",
    "https://api.hunter.io/*",
    "https://api.prospeo.io/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open LeadScout Prospector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
